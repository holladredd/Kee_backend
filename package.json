{
  "name": "kee-backend",
  "version": "1.0.0",
  "description": "Kee (Knowledge Extension Entity) - Backend API for personal AI memory and intelligence",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --dns-result-order=ipv4first src/index.js",
    "dev": "node --dns-result-order=ipv4first --watch src/index.js",
    "test:db": "node --dns-result-order=ipv4first src/test-db.js",
    "test": "node --dns-result-order=ipv4first --test tests/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "kee",
    "memory",
    "tasks",
    "reminders",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
