generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  attachments  Attachment[]
  memories     Memory[]
  reminders    Reminder[]
  syncLogs     SyncLog[]
  tasks        Task[]

  @@map("users")
}

model Memory {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  title            String
  originalContent  String       @map("original_content")
  processedContent String?      @map("processed_content")
  memoryType       String       @default("general_note") @map("memory_type")
  category         String       @default("General")
  tags             String[]     @default([])
  associatedPerson String?      @map("associated_person")
  associatedDate   DateTime?    @map("associated_date")
  isPinned         Boolean      @default(false) @map("is_pinned")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")
  attachments      Attachment[]
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders        Reminder[]
  tasks            Task[]

  @@index([userId])
  @@index([userId, category])
  @@index([userId, memoryType])
  @@index([userId, isPinned])
  @@index([userId, updatedAt])
  @@map("memories")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  memoryId    String?      @map("memory_id") @db.Uuid
  title       String
  description String?
  priority    String       @default("normal")
  status      String       @default("pending")
  dueDate     DateTime?    @map("due_date")
  dueTime     String?      @map("due_time")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  attachments Attachment[]
  reminders   Reminder[]
  memory      Memory?      @relation(fields: [memoryId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, updatedAt])
  @@map("tasks")
}

model Reminder {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  memoryId       String?  @map("memory_id") @db.Uuid
  title          String
  scheduledAt    DateTime @map("scheduled_at")
  timezone       String   @default("UTC")
  recurrenceRule String?  @map("recurrence_rule")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  memory         Memory?  @relation(fields: [memoryId], references: [id])
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, scheduledAt])
  @@index([userId, isEnabled])
  @@index([userId, updatedAt])
  @@map("reminders")
}

model Attachment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  memoryId        String?  @map("memory_id") @db.Uuid
  taskId          String?  @map("task_id") @db.Uuid
  fileName        String   @map("file_name")
  fileType        String   @map("file_type")
  fileSize        Int?     @map("file_size")
  localReference  String   @map("local_reference")
  remoteReference String?  @map("remote_reference")
  createdAt       DateTime @default(now()) @map("created_at")
  memory          Memory?  @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([taskId])
  @@map("attachments")
}

model SyncLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id") @db.Uuid
  action          String
  clientTimestamp DateTime @map("client_timestamp")
  serverTimestamp DateTime @default(now()) @map("server_timestamp")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverTimestamp])
  @@map("sync_logs")
}
